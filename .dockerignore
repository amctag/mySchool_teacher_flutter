# --- Build output (always generated by the Docker build, never committed) ---
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
coverage/

# --- VCS / editors / OS junk ---------------------------------------------
.git/
.gitignore
.idea/
.vscode/
*.iml
**/.DS_Store
__MACOSX/

# --- Mobile / desktop build artifacts (not needed for a Flutter web build) --
**/build/
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
ios/Pods/
ios/.symlinks/
macos/Pods/
**/ephemeral/

# --- Tests and local notes (not needed to compile the web bundle) ---------
test/
HANDOFF.md

# NOTE: do not ignore lib/, web/, images/, l10n.yaml, pubspec.yaml,
# pubspec.lock, analysis_options.yaml or .metadata - the web build needs them.
